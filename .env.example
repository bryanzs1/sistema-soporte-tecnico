# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/soporte_tecnico

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# LLM Configuration (Optional - for intelligent assistant conversations)
# If not set, the assistant will fall back to knowledge base matching

# Option 1: Groq API (Free tier with generous limits - RECOMMENDED)
# Get your free API key at: https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key-here

# Option 2: OpenAI API (Paid, used as fallback if Groq not configured)
# Get your API key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here
