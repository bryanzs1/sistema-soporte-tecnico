# Production Environment Variables for Render.com
# Copy these to Render dashboard and fill with actual values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-here-generate-one

# Database
DATABASE_URL=postgresql://soporte_user:password@localhost:5432/soporte_db

# Email Configuration (optional, for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# Application
PREFERRED_URL_SCHEME=https
SERVER_NAME=your-domain.com

# Security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
